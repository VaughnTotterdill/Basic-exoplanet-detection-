import numpy as np
import matplotlib.pyplot as plt

#open and load file

data = np.loadtxt("input_file.txt")
time_array_days = data[:, 0] #units of days 
flux = data[:, 1]
flux_error = data[:, 2]


#calculate terms before inputting into function 

#calculate w_i    -    w_i = 1 / sigma i ^2 

w_i = 1 / (flux_error**2) 

# calculate T = sum w_i for all i  -  so the length of the array 

T = np.sum(w_i)

# calculate f^ - f_hat = sum (fi * wi)/ T 

f_hat = ( np.sum(flux * w_i) ) / T 

# calculate f tilda = fi - f^ 

f_tilda_i = flux - f_hat 


#Create the function 
def BLS_algorithm(): 
    time_values = time_array_days 
    Trial_periods = np.arange(1, 10.01, 0.01) #period ranges 1-10 days with increments 0.01 days 
    bin_size = 2.4/24 # gives a bin size of 2.4 hours (number of bins varies for differing period lengths)

    # 4 arrays to return - Trial period i , chi_squared, depth, t0 
    array_chi_squared = []
    array_depth = []
    array_t0 = []

    for period_i in Trial_periods: 

        #calculate phase values - phase should go from 0 to 1 
        # phase_i = t_i mod period_i 
        phase_i = (time_values % period_i) / period_i 
        
        bin_width_in_phase_units = bin_size / period_i 

        number_of_bins = int(1/bin_width_in_phase_units) 
        
        bins = np.linspace(0, 1, number_of_bins + 1) 

        #S_j and R_j - j is bin number 
        #S = np.zeros(number_of_bins) 
        #R = np.zeros(number_of_bins) 
        #for i in range(len(phase_i)):
            #bin_index = int(phase_i[i] // bin_width_in_phase_units) #allocate bin - // largest integer less than or equal to division 
            #doesnt work due to indexing errors so use: 
            #bin_index = np.digitize(phase_i[i], bins) - 1

            #S[bin_index] += f_tilda_i[i] * w_i[i] 
            #R[bin_index] += w_i[i]
        
        #Histogram is MUCHHHH faster 
        #S = sum of (f_tilda_i * w_i) in each bin
        S, _ = np.histogram(phase_i, bins, weights=f_tilda_i * w_i)

        #R = sum of w_i in each bin
        R, _ = np.histogram(phase_i, bins, weights=w_i)


        #np.histogram(data, bins, weight)
        #data is data to sort, bins is either a number which is the number of bins or an array containing bin edges 
        #weights - summation of weights for each value in bin 

        #with np.errstate(divide='ignore', invalid='ignore'):
            #depth_j = S * T / (R * (T - R) ) 
            #chi_squared = S**2 * T / (R* (T - R) ) 
        
        depth_j = S * T / (R*(T-R))
        chi_squared = ( S**2 * T ) / (R * (T-R)) 

        #identify bin with highest chi_squared and its value of depth_j 
        highest_bin_chi_sqaured = np.argmax(chi_squared) # gives bin number j (left edge)

        #mid time of transit - add phase value of bin to minimum time stamp 
        min_time = np.min(time_values) 
        bin_phase_value = (bins[highest_bin_chi_sqaured] + bins[highest_bin_chi_sqaured + 1]) / 2  # Bin center
        t_0 = min_time + bin_phase_value*period_i

        array_chi_squared.append(chi_squared[highest_bin_chi_sqaured]) #save value for highest chi_squared to array for each period 
        array_depth.append(depth_j[highest_bin_chi_sqaured]) 
        array_t0.append(t_0)


    #note t0 is epoch 
    return Trial_periods, array_chi_squared, array_depth, array_t0 

#running the algorithm 

Trial_periods, array_chi_squared, array_depth, array_t0 = BLS_algorithm() 

