from scipy.optimize import curve_fit


def simulated_flux_calculator(time_stamps, orbital_period_P, epoch_t0, orbital_seperation_a, size_ratio_p): 
    
    Array_Flux_calculated = []

    for time_i in time_stamps: 

        theta_i = ( 2*np.pi * (time_i - epoch_t0) ) / orbital_period_P 
        d = np.abs(orbital_seperation_a * np.sin(theta_i)) 
        z=d 

        #Calculate lamda(p,z) 

        if np.cos(theta_i) < 0: 
            lambda_p_z = 0  # No transit when planet is behind the star
        elif z > 1 + size_ratio_p:
            lambda_p_z = 0  # No overlap between planet and star
        elif z <= 1 - size_ratio_p:
            lambda_p_z = size_ratio_p**2  # Planet is fully in front of the star
        elif z <= size_ratio_p - 1:
            lambda_p_z = 1  # Star is fully eclipsed by the planet
        else:  # Partial overlap
            k_1 = np.arccos((1 - size_ratio_p**2 + z**2) / (2 * z))
            k_0 = np.arccos((size_ratio_p**2 + z**2 - 1) / (2 * size_ratio_p * z))
            lambda_p_z = ((1 / np.pi)* ((size_ratio_p**2 * k_0)+ k_1- np.sqrt((4 * z**2 - (1 + z**2 - size_ratio_p**2)**2) / 4)))


        #Calculate flux 

        Flux_p_z = 1 - lambda_p_z 

        Array_Flux_calculated.append(Flux_p_z)

    return np.array(Array_Flux_calculated) 



